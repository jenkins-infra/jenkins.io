#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

TYPOS_VERSION=v1.51.1

if command -v typos >/dev/null 2>&1; then
    TYPOS_BIN="typos"
else
    ARCH=$(uname -m)
    if [[ "$ARCH" == "arm64" || "$ARCH" == "aarch64" ]]; then
        TARGET_ARCH="aarch64"
    else
        TARGET_ARCH="x86_64"
    fi

    if [[ ! -x ./typos ]] || [[ "$(./typos --version 2>/dev/null)" != *" ${TYPOS_VERSION#v}"* ]]; then
        if [[ $OSTYPE == darwin* ]] ; then
            curl --disable --silent --show-error --location "https://github.com/crate-ci/typos/releases/download/${TYPOS_VERSION}/typos-${TYPOS_VERSION}-${TARGET_ARCH}-apple-darwin.tar.gz" | tar xzf - ./typos
        else
            curl --disable --silent --show-error --location "https://github.com/crate-ci/typos/releases/download/${TYPOS_VERSION}/typos-${TYPOS_VERSION}-${TARGET_ARCH}-unknown-linux-musl.tar.gz" | tar xzf - ./typos
        fi
    fi
    TYPOS_BIN="./typos"
fi

if [[ -n "${CI:-}" ]] ; then
    "${TYPOS_BIN}" --format sarif > typos.sarif || true
else
    "${TYPOS_BIN}"
fi
