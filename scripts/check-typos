#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

if ! command -v typos >/dev/null 2>&1; then
    echo 'Error: typos is required. Install it and add it to PATH. See Prerequisites in CONTRIBUTING.adoc.' >&2
    exit 1
fi

if [[ -n "${CI:-}" ]] ; then
    typos --format sarif > typos.sarif || true
else
    typos
fi
