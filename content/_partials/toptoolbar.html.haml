%jio-navbar#ji-toolbar.fixed-nav{:property=>(page.jio_property || "https://www.jenkins.io"), :theme => "auto", :showSearchBox=>!page.hide_search_bar}
  - if page.jio_property
    -# The default brand link is a hard-coded href="/", which points at the other site.
    -# Inline style keeps the page's own link colors from overriding the component's brand style.
    %a{:slot => "brand", :href => "https://www.jenkins.io/", :style => "color: #fff; text-decoration: none;"} Jenkins
