.plugins-list
  %h4= page.title

  %div.content
    - if page.plugins
      %div.item-list
        %ul.ji-dated-list.ji-item-list.plugins
          - page.plugins.each do |link, title, description|
            %li.post
              %a.article{:href => link}
                %h6.title= title
                %p.url= description
